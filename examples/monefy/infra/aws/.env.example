NODE_ENV=production
PDF_DEVELOPMENT_DELAY=false
PUBLIC_ORIGIN=https://monefy.thood.ro
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
JWT_SECRET=replace-with-a-unique-random-jwt-secret
RABBITMQ_PASSWORD=replace-with-a-unique-random-broker-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-address@gmail.com
SMTP_PASSWORD='replace-with-google-app-password'
MAIL_FROM='Monefy <replace-with-your-address@gmail.com>'
REGISTRATION_EMAIL_DOMAIN=thood.ro
PDF_CACHE_SECONDS=86400