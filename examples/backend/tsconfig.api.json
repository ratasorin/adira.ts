{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./shared/dist",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": false
  },
  "files": ["./shared/index.api.d.ts"],
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
