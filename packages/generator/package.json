{
  "name": "@n/adira.generator.ts",
  "version": "0.1.0",
  "description": "Generator for parsing Express.js routes and generating TypeScript API definitions",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "keywords": [
    "typescript",
    "api",
    "generator",
    "express",
    "routes"
  ],
  "author": "Sorin Rata <ratasorin0@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@n/adira.core.ts": "file:../core",
    "typescript": "^5.9.3",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
