{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Input configuration",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory to watch for incoming input files"
        }
      },
      "required": ["dir"]
    },
    "output": {
      "type": "object",
      "description": "Output configuration",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory to write generated output files"
        },
        "file": {
          "type": "string",
          "description": "Name of the generated output file"
        },
        "typename": {
          "type": "string",
          "description": "Name of the generated type"
        }
      },
      "required": ["dir"]
    },
    "registry": {
      "type": "object",
      "description": "Configuration related to the package registry",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the package registry"
        },
        "description": {
          "type": "string",
          "description": "A brief description for the package"
        },
        "version": {
          "type": "string",
          "description": "Version of the package registry"
        },
        "url": {
          "type": "string",
          "description": "URL of the package registry"
        },
        "port": {
          "type": "number",
          "description": "Port number for the package registry"
        }
      },
      "required": ["port"]
    }
  },
  "required": ["input", "output", "registry"]
}
