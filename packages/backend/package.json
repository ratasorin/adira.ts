{
  "name": "@n/adira.backend.ts",
  "version": "0.1.0",
  "description": "Backend utilities for API route handlers with MongoDB aggregation functions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run test:types && npm run test:integration && npm run test:generated",
    "test:types": "tsc -p tsconfig.type-tests.json && tsc -p tsconfig.test.json && npm run test:diagnostics",
    "test:diagnostics": "TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register test/diagnostics.test.ts",
    "test:integration": "TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register test/read.test.ts",
    "test:generated": "TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register test/generated.test.ts",
    "demo:read": "TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register test/demo.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "typescript",
    "mongoose",
    "api",
    "handlers",
    "aggregation"
  ],
  "author": "Sorin Rata <ratasorin0@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@n/adira.core.ts": "^0.1.0",
    "mongoose": "^8.19.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "express": "^4.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
