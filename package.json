{
  "name": "@n/adira.ts",
  "version": "0.0.1",
  "description": "API type builder for seamless, strongly-typed backend integrations.",
  "keywords": [
    "typescript",
    "api",
    "type-generator"
  ],
  "author": "Rata Sorin <ratasorin0@gmail.com>",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "types:generate": "npx ts-node ./packages/@invoicify/generator/index.ts --c ./packages/@invoicify/generator/tsconfig.json",
    "types:publish": "./packages/package.manager.sh PUBLISH @invoicify/types",
    "types:build": "./packages/package.manager.sh BUILD @invoicify/types",
