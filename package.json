{
  "name": "@n/adira.ts",
  "version": "0.0.1",
  "description": "API type builder for seamless, strongly-typed backend integrations.",
  "keywords": [
    "typescript",
    "api",
    "type-generator",
    "express",
    "mongoose"
  ],
  "author": "Rata Sorin <ratasorin0@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "types:remove": "ts-node packages/cli/src/scripts/remove-types.ts",
    "types:build": "ts-node packages/cli/src/scripts/build-types.ts",
    "types:publish": "ts-node packages/cli/src/scripts/publish-types.ts"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "private": true,
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5"
  }
}
